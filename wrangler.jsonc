
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortlink",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-06-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "APP_URL": "https://shortlink.linkearnx.workers.dev",
    "DB_DRIVER": "d1",
    "PBKDF2_ITERATIONS": "20000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortlink-db",
      "migrations_dir": "drizzle/sqlite"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LINKS_KV"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      {
        "name": "CLICK_AGG",
        "class_name": "ClickAggregator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ClickAggregator"]
    }
  ]
}
